// The tree Sampson starts from: `Expr` is a `shared` type, so each node holds
// its children through a reference-counted pointer and nothing needs a pool.

// Not Add/Sub/Mul/Div: those names are the prelude's operator traits.
type BinOp =
   | Plus
   | Minus
   | Times
   | Divide

shared type Expr =
   | Binary BinOp Expr Expr
   | Literal I64

interp (e: Expr): I64 =
    match e
    | Binary op lhs rhs ->
        l = interp lhs
        r = interp rhs
        match op
        | Plus -> l + r
        | Minus -> l - r
        | Times -> l * r
        | Divide -> if r == 0 then 0 else l / r
    | Literal num -> num

lit (n: I64): Expr = Literal n
bin (op: BinOp) (l: Expr) (r: Expr): Expr = Binary op l r

main () =
    e = bin Divide (bin Times (bin Minus (lit 7) (lit 10)) (lit 7)) (lit 2)
    println (interp e)
    f = bin Divide (bin Plus (lit 4) (lit 4)) (bin Minus (lit 4) (lit 4))
    println (interp f)
    println (interp e)
