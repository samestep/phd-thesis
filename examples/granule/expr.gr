-- Coeffects: nothing is implicit, but each grade says how a value may be used ([] = freely).
data Bool = False | True

data List a = Nil | Cons a (List a)

data BinOp = Add | Sub | Mul | Div

data Expr = Binary BinOp (Int []) (Int []) | Literal Int

-- Expressions newest first, and how many there are.
data ExprPool = ExprPool (List (Expr [])) (Int [])

empty : ExprPool []
empty = [ExprPool Nil [0]]

add : Expr [] -> ExprPool [] -> (Int [], ExprPool [])
add [e] [(ExprPool es [k])] = ([k], [ExprPool (Cons [e] es) [k + 1]])

nth : Int [] -> (List (Expr [])) [] -> Expr
nth [_] [Nil] = Literal 0;
nth [i] [(Cons [x] xs)] = if i == 0 then x else nth [i - 1] [xs]

get : Int [] -> ExprPool [] -> Expr
get [r] [(ExprPool es [k])] = nth [k - 1 - r] [es]

sign : Int [] -> Int
sign [x] = if x < 0 then 0 - 1 else 1

absI : Int [] -> Int
absI [x] = sign [x] * x

-- Granule's `div` floors; the post's division truncates toward zero.
quot : Int [] -> Int [] -> Int
quot [x] [y] =
  if y == 0 then 0 else sign [x] * sign [y] * div (absI [x]) (absI [y])

apply : BinOp -> Int [] -> Int [] -> Int
apply Add [l] [r] = l + r;
apply Sub [l] [r] = l - r;
apply Mul [l] [r] = l * r;
apply Div [l] [r] = quot [l] [r]

interp : Int [] -> ExprPool [] -> Int
interp [e] [(ExprPool es [k])] = case get [e] [ExprPool es [k]] of
  Binary op [lhs] [rhs] -> apply op [interp [lhs] [ExprPool es [k]]] [interp [rhs] [ExprPool es [k]]];
  Literal num -> num

lit : Int [] -> ExprPool [] -> (Int [], ExprPool [])
lit [n] = add [Literal n]

bin : BinOp [] -> Int [] -> Int [] -> ExprPool [] -> (Int [], ExprPool [])
bin [op] [l] [r] = add [Binary op [l] [r]]

main : () <{Stdout}>
main =
  let (a, p) = lit [7] empty;
      (b, p) = lit [10] p;
      (s, p) = bin [Sub] a b p;
      (c, p) = lit [7] p;
      (m, p) = bin [Mul] s c p;
      (d, p) = lit [2] p;
      (e, p) = bin [Div] m d p;
      [e] = e;
      [p] = p;
      inner = (let (x, q) = lit [4] empty;
                   (y, q) = lit [4] q;
                   (n, q) = bin [Add] x y q;
                   (z, q) = lit [4] q;
                   (w, q) = lit [4] q;
                   (o, q) = bin [Sub] z w q;
                   (f, q) = bin [Div] n o q
               in interp f q)
  in toStdout (stringAppend (showInt (interp [e] [p])) (stringAppend "\n"
       (stringAppend (showInt inner) (stringAppend "\n"
       (stringAppend (showInt (interp [e] [p])) "\n")))))
