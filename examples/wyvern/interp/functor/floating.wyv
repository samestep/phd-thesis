// `Float` is a Java `double`.
module def floating(stdout: Stdout): Arith

import wyvern.Float

type V = Float

def value(n: Int): Float = Float.ofInt(n)
// `floor` is the only way from a `Float` to an `Int`.
def print(v: Float): Unit
    stdout.printInt((v + 0.5).floor())
    stdout.println()
def add(x: Float, y: Float): Float = x + y
def sub(x: Float, y: Float): Float = x - y
def mul(x: Float, y: Float): Float = x * y
def div(x: Float, y: Float): Float = x / y
