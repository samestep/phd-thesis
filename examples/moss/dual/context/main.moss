import "wasi.moss" use WasiStd;
import "wasistd.moss" use Branch;
import "wasm.moss" use Wasm;
import "wasip1.moss" use Wasi;
import "../../common.moss" use print_int, Reals;

# Forward-mode differentiation by rebinding `Float`. `f` is written
# against `Float` alone, literals included; `bind Float = Dual` over the
# `Float` in force makes the same `f` compute a derivative, and doing it
# twice, duals over duals, a second, all inside functions that are
# themselves generic over `Float`. Each bind of `Float` is a new
# generation of it, so the outer and inner variables of a nested
# derivative are different types, and `nested` has to say how the outer
# one enters the inner differentiation (as a constant, `still`): adding
# it as it is would be a type error rather than perturbation confusion.
# Output, times a million: f(2), f'(2), f''(2); Newton's iterates for the
# root of f from 2; then d/dx (x * d/dy (x + y)) at 1, which is 1.

assume Reals {
  fn f(x: Float): Float { x * x * x - 2.0 * x - 5.0 }
}

type Base;

assume Int, Base {
  fn lift(n: Int): Base;
  context BaseOps = Base, lift, Base.add, Base.sub, Base.mul, Base.div;
}

assume Int, zero, one, BaseOps {
  type Dual { v: Base, d: Base };

  fn constant(n: Int): Dual { Dual { v = lift(n), d = lift(zero) } }
  fn variable(x: Base): Dual { Dual { v = x, d = lift(one) } }
  fn still(x: Base): Dual { Dual { v = x, d = lift(zero) } }
}

functor Dualize: Std -> Float, float, Float.add, Float.sub, Float.mul, Float.div {
  bind Base = Float;
  bind lift = float;
  bind Float = Dual;
  bind float = constant;
  bind Float.add = (r) => Dual { v = this.v + r.v, d = this.d + r.d };
  bind Float.sub = (r) => Dual { v = this.v - r.v, d = this.d - r.d };
  bind Float.mul = (r) => Dual { v = this.v * r.v, d = this.d * r.v + this.v * r.d };
  bind Float.div = (r) => Dual { v = this.v / r.v, d = (this.d * r.v - this.v * r.d) / (r.v * r.v) };
}

assume Std {

  fn show(x: Float) {
    print_int((x * 1000000.0).round());
    putchar(char::newline);
  }

  fn derivatives(x: Float) {
    show(f(x));
    show({
      bind Dualize;
      f(variable(x)).d
    });
    show({
      bind Dualize;
      let x1 = variable(x);
      {
        bind Dualize;
        f(variable(x1)).d.d
      }
    });
  }

  fn newton(x0: Float, steps: Int) {
    var x = x0;
    var i = 0;
    while i < steps {
      let step = {
        bind Dualize;
        let y = f(variable(x));
        y.v / y.d
      };
      x = x - step;
      show(x);
      i = i + 1;
    }
  }

  # d/dx (x * d/dy (x + y)) at x = 1, y = 1.
  fn nested(at: Float): Float {
    {
      bind Dualize;
      let x = variable(at);
      let y0 = 1.0;
      let inner = {
        bind Dualize;
        (still(x) + variable(y0)).d
      };
      x * inner
    }.d
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    derivatives(2.0);
    newton(2.0, 4);
    show(nested(1.0));
  }
}
