import "wasistd.moss" use Branch, Chr, Containers, WasiNumerics, WasiContainers,
  heap_mark, heap_reset;
import "wasm.moss" use Wasm, Memory, I32;

# An arena in a second linear memory: what the other languages' arena
# examples get from their standard libraries or crates. Imported by a
# relative path, so the examples' `check.nix` lists it as `shared`.
#
# Guaranteed: nothing made in the arena outlives the block that applied
# `Arena`. Letting it out (as the block's value, assigned to an outer
# variable, or inside a record) is a compile error. Not guaranteed:
# applying `Arena` again inside such a block resets the arena under the
# first application's data, and so does calling `heap_reset` by hand.

# A second linear memory, for the arena to live in.
tag Scratch;

assume Wasm {
  # Where `Scratch`'s allocator starts, read once before anything is
  # allocated there.
  val scratch_base: I32;
  # Where the arena's allocator starts, after `Arena` resets it.
  val fresh: I32;
}

# Applying `Arena` gives you a fresh arena: each `bind Arena;` resets
# its memory, and makes a new `Memory` with new containers in it, so
# nothing allocated there can leave the block that applied it. It lists
# no polymorphic inputs (D84, draft): it is fixed in the `Int` and `Char`
# its containers mention, which `InScratch` pins to the library's, so it
# is bound where they are in force, after `WasiStd`.
functor Arena[]: Wasm, Branch, scratch_base -> Memory, Containers, fresh;

# The arena in `Scratch`, reset as it is applied.
functor InScratch: Wasm, Branch, scratch_base -> Memory, Containers, fresh {
  bind Memory = Scratch;
  bind fresh = {
    heap_reset(scratch_base);
    scratch_base
  };
  bind WasiNumerics;
  bind Char = Chr;
  bind WasiContainers;
}

# What code that applies `Arena` assumes, and how `main` provides it.
context Arenas = scratch_base, Arena;

functor ScratchArena: Wasm, Branch -> Arenas {
  bind scratch_base = {
    bind Memory = Scratch;
    heap_mark()
  };
  bind Arena = InScratch;
}
