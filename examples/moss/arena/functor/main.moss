import "wasi.moss" use WasiStd;
import "wasistd.moss" use Branch, Numerics, Containers;
import "wasm.moss" use Wasm;
import "wasip1.moss" use Wasi;
import "../../arena.moss" use Arena, Arenas, ScratchArena;
import "../../common.moss" use print_int;

# For each start value, the Collatz trajectory down to 1 is built as a
# temporary list in an arena, and only two numbers are kept from it: how
# many steps it took, and the largest value on the way. `Arena`, and
# what it does and does not guarantee, is in `../../arena.moss`.

assume Char, Numerics, Containers {
  tag Summary { steps: Int, peak: Int };

  fn summarize(start: Int): Summary {
    let path = int_list();
    var n = start;
    path.push(n);
    while n != 1 {
      if n % 2 == 0 {
        n = n / 2;
      } else {
        n = 3 * n + 1;
      }
      path.push(n);
    }
    var peak = path.get(0);
    var i = 1;
    while i < path.length() {
      if path.get(i) > peak {
        peak = path.get(i);
      }
      i = i + 1;
    }
    Summary { steps = path.length() - 1, peak }
  }
}

assume Std, Wasm, Wasi, Branch, Arenas {
  fn report() {
    let starts = int_list();
    starts.push(6);
    starts.push(7);
    starts.push(27);
    starts.push(97);
    var i = 0;
    while i < starts.length() {
      let start = starts.get(i);
      let summary = {
        bind Arena;
        summarize(start)
      };
      print_int(start);
      putchar(char::space);
      print_int(summary.steps);
      putchar(char::space);
      print_int(summary.peak);
      putchar(char::newline);
      i = i + 1;
    }
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind ScratchArena;
    report();
  }
}
