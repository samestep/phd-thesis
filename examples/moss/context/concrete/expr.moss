import "wasi.moss" use WasiStd;
import "wasistd.moss" use Branch;
import "wasm.moss" use Wasm;
import "wasip1.moss" use Wasi;

assume Std {
  # region: types
  unit Add;
  unit Sub;
  unit Mul;
  unit Div;

  type BinOp = Add | Sub | Mul | Div;

  # An expression is just an index into a pool of nodes.
  type ExprRef Int;

  type Binary { op: BinOp, lhs: ExprRef, rhs: ExprRef };
  type Literal Int;

  type Expr = Binary | Literal;

  # The pool: one row per node, across parallel lists.
  type ExprPool { ops: IntList, lhs: IntList, rhs: IntList };

  val pool: ExprPool;
  # endregion

  assume pool {
    # region: pool
    fn ExprRef.index(): Int {
      match this { ExprRef i => i }
    }

    fn add(expr: Expr): ExprRef {
      let i = pool.ops.length();
      match expr {
        Binary { op, lhs, rhs } => {
          pool.ops.push(op_code(op));
          pool.lhs.push(lhs.index());
          pool.rhs.push(rhs.index());
        },
        Literal num => {
          pool.ops.push(zero);
          pool.lhs.push(num);
          pool.rhs.push(zero);
        },
      }
      ExprRef (i)
    }

    fn get(expr: ExprRef): Expr {
      let i = expr.index();
      let code = pool.ops.get(i);
      if code.eq(zero) {
        Literal (pool.lhs.get(i))
      } else {
        Binary {
          op = op_of(code),
          lhs = ExprRef (pool.lhs.get(i)),
          rhs = ExprRef (pool.rhs.get(i)),
        }
      }
    }
    # endregion

    # region: interp
    fn ExprRef.interp(): Int {
      match get(this) {
        Binary { op, lhs, rhs } => {
          let l = lhs.interp();
          let r = rhs.interp();
          match op {
            Add => l.add(r),
            Sub => l.sub(r),
            Mul => l.mul(r),
            Div => if r.eq(zero) { zero } else { l.div(r) },
          }
        },
        Literal num => num,
      }
    }
    # endregion

    fn lit(n: Int): ExprRef { add(Literal (n)) }
    fn bin(op: BinOp, lhs: ExprRef, rhs: ExprRef): ExprRef { add(Binary { op, lhs, rhs }) }

    fn report(e: ExprRef) {
      print_int(e.interp());
      putchar(char::newline);
    }
  }

  fn op_code(op: BinOp): Int {
    match op {
      Add => one,
      Sub => one.add(one),
      Mul => one.add(one).add(one),
      Div => one.shl(one.add(one)),
    }
  }

  fn op_of(code: Int): BinOp {
    if code.eq(one) {
      Add
    } else if code.eq(one.add(one)) {
      Sub
    } else if code.eq(one.add(one).add(one)) {
      Mul
    } else {
      Div
    }
  }

  fn print_int(n: Int) {
    if n.lt(zero) {
      putchar(char::hyphen);
      print_int(zero.sub(n));
      return ();
    }
    let ten = one.shl(one.add(one).add(one)).add(one.add(one));
    if n.ge(ten) { print_int(n.div(ten)); }
    putchar(n.rem(ten).add(char::digit0.code()).char());
  }

  # region: main
  fn elsewhere() {
    bind pool = ExprPool { ops = int_list(), lhs = int_list(), rhs = int_list() };
    let four = one.shl(one.add(one));
    report(bin(Div, bin(Add, lit(four), lit(four)), bin(Sub, lit(four), lit(four))));
  }

  fn demo() {
    bind pool = ExprPool { ops = int_list(), lhs = int_list(), rhs = int_list() };
    let two = one.add(one);
    let seven = two.shl(two).sub(one);
    let ten = seven.add(two).add(one);
    let e = bin(Div, bin(Mul, bin(Sub, lit(seven), lit(ten)), lit(seven)), lit(two));
    report(e);
    elsewhere();
    report(e);
  }
  # endregion
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
