import "./lib/wasi.moss" use WasiStd;
import "./lib/wasistd.moss" use Branch;
import "./lib/wasm.moss" use Wasm;
import "./lib/wasip1.moss" use Wasi;

assume Std {
  # region: types
  # An expression is just an index into a pool of nodes.
  type Expr Int;

  type Lit Int;
  type Add { l: Expr, r: Expr };
  type Mul { l: Expr, r: Expr };

  type Node = | Lit | Add | Mul;

  # The pool: one row per node, across parallel lists.
  val ops: IntList;
  val lhs: IntList;
  val rhs: IntList;

  context Pool = ops, lhs, rhs;
  # endregion

  assume Pool {
    # region: accessors
    fn Expr.id(): Int {
      match this { Expr i => i }
    }

    fn Expr.node(): Node {
      let i = this.id();
      let l = Expr (lhs.get(i));
      let r = Expr (rhs.get(i));
      let code = ops.get(i);
      if code.eq(zero) {
        Lit (lhs.get(i))
      } else if code.eq(one) {
        Add { l, r }
      } else {
        Mul { l, r }
      }
    }
    # endregion

    # region: eval
    fn Expr.eval(): Int {
      match this.node() {
        Lit n => n,
        Add { l, r } => l.eval().add(r.eval()),
        Mul { l, r } => l.eval().mul(r.eval()),
      }
    }
    # endregion

    # region: build
    fn node(op: Int, a: Int, b: Int): Expr {
      let id = ops.length();
      ops.push(op);
      lhs.push(a);
      rhs.push(b);
      Expr (id)
    }

    fn lit(n: Int): Expr { node(zero, n, zero) }
    fn add(l: Expr, r: Expr): Expr { node(one, l.id(), r.id()) }
    fn mul(l: Expr, r: Expr): Expr { node(one.add(one), l.id(), r.id()) }
    # endregion

    fn report(e: Expr) {
      print_int(e.eval());
      putchar(char::newline);
    }
  }

  fn print_int(n: Int) {
    let ten = one.shl(one.add(one).add(one)).add(one.add(one));
    if n.ge(ten) { print_int(n.div(ten)); }
    putchar(n.rem(ten).add(char::digit0.code()).char());
  }

  # region: main
  fn elsewhere() {
    bind ops = int_list(), lhs = int_list(), rhs = int_list();
    let four = one.shl(one.add(one));
    report(add(lit(four), lit(four)));
  }

  fn demo() {
    bind ops = int_list(), lhs = int_list(), rhs = int_list();
    let two = one.add(one);
    let three = two.add(one);
    let four = two.add(two);
    let e = mul(add(lit(one), lit(two)), add(lit(three), lit(four)));
    report(e);
    elsewhere();
    report(e);
  }
  # endregion
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
