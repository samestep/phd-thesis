import "access.moss" use Elem, Index, .set;
import "array.moss" use Item, Array, .arrayed;
import "wasi.moss" use WasiStd;
import "wasistd.moss" use Branch, WasiFloats32, Double, Single, dbl, sgl;
import "wasm.moss" as w use Wasm;
import "wasip1.moss" use Wasi;
import "../../common.moss" use print_int;

# How numbers are stored, separately from how they are computed: an array
# of the stored type, and how a `Float` becomes one and back.
type Stored;
type Store;

assume Std, Stored, Store {
  fn store(n: Int): Store;
  fn narrow(x: Float): Stored;
  fn widen(x: Stored): Float;
  context Storage =
    Stored, Store, store, narrow, widen,
    Store.set[Elem=Stored, Index=Int], Store.get[Elem=Stored, Index=Int];
}

# Written once, against `Float` and `Storage`, with no layer naming either:
# fill an array with `n` copies of 0.1, then sum it.
assume Std, Storage {
  fn fill(n: Int): Store {
    let xs = store(n);
    var i = 0;
    while i < n {
      xs.set(i, narrow(0.1));
      i = i + 1;
    }
    xs
  }

  fn accumulate(xs: Store, from: Int, to: Int): Float {
    var sum = 0.0;
    var i = from;
    while i < to {
      sum = sum + widen(xs.get(i));
      i = i + 1;
    }
    sum
  }

  fn total(xs: Store, n: Int): Float { accumulate(xs, 0, n) }

  fn scaled(xs: Store, n: Int): Int { (total(xs, n) * 1000.0).round() }

  fn report(n: Int) {
    print_int(scaled(fill(n), n));
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    # Compute in f64, store in f64: an array of `Float`.
    {
      bind Stored = Float;
      bind Store = Array[Item=Float];
      bind store = (n) => 0.0.arrayed(n);
      bind narrow = (x) => x;
      bind widen = (x) => x;
      report(1000000);
    }
    # Compute in f64, store in f32: half the memory.
    {
      bind Stored = Single;
      bind Store = Array[Item=Single];
      bind narrow = (x) => Single(w::f32_demote_f64(dbl(x)));
      bind widen = (x) => Double(w::f64_promote_f32(sgl(x)));
      bind store = (n) => narrow(0.0).arrayed(n);
      report(1000000);
    }
    # Compute in f32, store in f32.
    {
      bind WasiFloats32;
      bind Stored = Float;
      bind Store = Array[Item=Float];
      bind store = (n) => 0.0.arrayed(n);
      bind narrow = (x) => x;
      bind widen = (x) => x;
      report(1000000);
    }
  }
}
