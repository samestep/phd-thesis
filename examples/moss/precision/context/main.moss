import "wasi.moss" use WasiStd;
import "wasistd.moss" use Branch, WasiFloats32, Num, raw, Ints, Double, Single, dbl, sgl;
import "wasm.moss" as w use Wasm, I64;
import "wasip1.moss" use Wasi;

# How numbers are stored, separately from how they are computed: a stored
# type, how a `Float` becomes one and back, and its layout in an `IntList`
# (`width` words each).
type Stored;

assume Std, Stored {
  fn narrow(x: Float): Stored;
  fn widen(x: Stored): Float;
  fn put(x: Stored, list: IntList);
  fn take(list: IntList, index: Int): Stored;
  val width: Int;
  context Storage = Stored, narrow, widen, put, take, width;
}

# Written once: fill a list with `n` copies of 0.1, computed in `Float`
# and stored as `Stored`, then sum them in `Float`.
assume Std, Storage {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }

  fn report(n: Int) {
    let list = int_list();
    var i = 0;
    while i < n {
      put(narrow(0.1), list);
      i = i + 1;
    }
    var sum = 0.0;
    i = 0;
    while i < n {
      sum = sum + widen(take(list, i * width));
      i = i + 1;
    }
    print_int((sum * 1000.0).round());
    putchar(char::newline);
  }
}

# The storage formats, over the standard library's own representations:
# `Single` and `Double` are WASI's f32 and f64 `Float`s, and `Ints` its
# `IntList`, one i32 per word.
assume Wasm, Branch {
  fn bits32(x: Single): Num { Num (w::i32_reinterpret_f32(sgl(x))) }
  fn from_bits32(n: Num): Single { Single (w::f32_reinterpret_i32(raw(n))) }

  fn put_single(x: Single, list: Ints) { list.push(bits32(x)); }
  fn take_single(list: Ints, index: Num): Single { from_bits32(list.get(index)) }

  fn put_double(x: Double, list: Ints) {
    let bits = w::i64_reinterpret_f64(dbl(x));
    list.push(Num (w::i32_wrap_i64(bits)));
    list.push(Num (w::i32_wrap_i64(w::i64_shr_u(bits, thirty_two()))));
  }
  fn take_double(list: Ints, index: Num): Double {
    let low = w::i64_extend_i32_u(raw(list.get(index)));
    let high = w::i64_extend_i32_u(raw(list.get(Num (w::i32_add(raw(index), w::i32_one)))));
    Double (w::f64_reinterpret_i64(w::i64_or(low, w::i64_shl(high, thirty_two()))))
  }

  # 32, the shift between an f64's two words.
  fn thirty_two(): I64 {
    let two = w::i32_add(w::i32_one, w::i32_one);
    let five = w::i32_add(two, w::i32_add(two, w::i32_one));
    w::i64_extend_i32_u(w::i32_shl(w::i32_one, five))
  }

  fn single(x: Single): Single { x }
  fn double(x: Double): Double { x }
  fn demote(x: Double): Single { Single (w::f32_demote_f64(dbl(x))) }
  fn promote(x: Single): Double { Double (w::f64_promote_f32(sgl(x))) }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    # Compute in f64, store in f64.
    {
      bind Stored = Double;
      bind narrow = double;
      bind widen = double;
      bind put = put_double;
      bind take = take_double;
      bind width = 2;
      report(1000000);
    }
    # Compute in f64, store in f32: half the memory.
    {
      bind Stored = Single;
      bind narrow = demote;
      bind widen = promote;
      bind put = put_single;
      bind take = take_single;
      bind width = 1;
      report(1000000);
    }
    # Compute in f32, store in f32.
    {
      bind WasiFloats32;
      bind Stored = Single;
      bind narrow = single;
      bind widen = single;
      bind put = put_single;
      bind take = take_single;
      bind width = 1;
      report(1000000);
    }
  }
}
