import "access.moss" use .get, .length, .push;
import "wasi.moss" use WasiStd;
import "wasistd.moss" use Branch;
import "wasm.moss" use Wasm;
import "wasip1.moss" use Wasi;
import "../../common.moss" use print_line;
import "../../shadow.moss" use Shadow, tolerance;

# Kahan's harness (shadow.moss) around the rerun example's `readings`,
# `sd`, `show` and `report`, copied unchanged from
# examples/moss/rerun/context/main.moss: p in f64 and P in double-double,
# side by side, with P following p's branches. Then two benign inputs of
# the same shape, which should draw no report.

assume Std {
  # NIST StRD NumAcc4: 10000000.2, then 10000000.1 and 10000000.3 in turn.
  fn readings(): FloatList {
    let xs = float_list();
    xs.push(10000000.2);
    var i = 1;
    while i < 1001 {
      if i % 2 == 1 { xs.push(10000000.1); } else { xs.push(10000000.3); }
      i = i + 1;
    }
    xs
  }

  # The schoolbook one-pass formula, as PostgreSQL's `stddev` computed
  # it until version 12, clamp included.
  fn sd(xs: FloatList): Float {
    var n = 0.0;
    var sum = 0.0;
    var sum_sq = 0.0;
    var i = 0;
    while i < xs.length() {
      let x = xs.get(i);
      n = n + 1.0;
      sum = sum + x;
      sum_sq = sum_sq + x * x;
      i = i + 1;
    }
    let numerator = n * sum_sq - sum * sum;
    if numerator <= 0.0 { 0.0 } else { (numerator / (n * (n - 1.0))).sqrt() }
  }

  fn show(sd: Float) { print_line((sd * 1000000000.0).round()); }

  fn report() { show(sd(readings())); }
}

# Not from the example: benign inputs for the same `sd`.
assume Std {
  # NumAcc4's shape, centred near 0: 0.2, then 0.1 and 0.3 in turn.
  fn centred(): FloatList {
    let xs = float_list();
    xs.push(0.2);
    var i = 1;
    while i < 1001 {
      if i % 2 == 1 { xs.push(0.1); } else { xs.push(0.3); }
      i = i + 1;
    }
    xs
  }

  # Small integers in the same shape: 2, then 1 and 3 in turn.
  fn small(): FloatList {
    let xs = float_list();
    xs.push(2.0);
    var i = 1;
    while i < 1001 {
      if i % 2 == 1 { xs.push(1.0); } else { xs.push(3.0); }
      i = i + 1;
    }
    xs
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    # How far P may stray from p, relative, before the harness says so.
    bind tolerance = 1e-9;
    report();                                 # p alone
    { bind Shadow; report(); }                # p and P: NumAcc4
    { bind Shadow; show(sd(centred())); }     # p and P: benign
    { bind Shadow; show(sd(small())); }
  }
}
