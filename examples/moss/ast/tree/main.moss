import "wasi.moss" use WasiStd;
import "wasistd.moss" use Branch;
import "wasm.moss" use Wasm, Boxed, Ref, Heap, .boxed;
import "wasip1.moss" use Wasi;
import "../../common.moss" use print_line;

# The tree Sampson starts from: each node holds its children through a
# `Ref` to the garbage-collected heap, as Rust's do through a `Box`, so
# nothing needs a pool, but every node is its own heap allocation.

unit Add;
unit Sub;
unit Mul;
unit Div;

type BinOp = Add | Sub | Mul | Div;

assume Std, Wasm {
  type Binary { op: BinOp, lhs: Ref[Boxed=Expr], rhs: Ref[Boxed=Expr] };
  type Literal Int;

  type Expr = Binary | Literal;

  # Making and following a reference to an `Expr`, which `main` provides.
  context ExprHeap = Expr.boxed[Boxed=Expr], Ref.deref[Boxed=Expr];
}

assume Std, Wasm, ExprHeap {
  fn interp(expr: Ref[Boxed=Expr]): Int {
    match expr.deref() {
      Binary { op, lhs, rhs } => {
        let l = interp(lhs);
        let r = interp(rhs);
        match op {
          Add => l + r,
          Sub => l - r,
          Mul => l * r,
          Div => if r == 0 { 0 } else { l / r },
        }
      },
      Literal num => num,
    }
  }

  fn new(expr: Expr): Ref[Boxed=Expr] { expr.boxed() }
  fn lit(n: Int): Ref[Boxed=Expr] { new(Literal (n)) }
  fn bin(op: BinOp, lhs: Ref[Boxed=Expr], rhs: Ref[Boxed=Expr]): Ref[Boxed=Expr] { new(Binary { op, lhs, rhs }) }

  fn demo() {
    let e = bin(Div, bin(Mul, bin(Sub, lit(7), lit(10)), lit(7)), lit(2));
    print_line(interp(e));
    {
      let f = bin(Div, bin(Add, lit(4), lit(4)), bin(Sub, lit(4), lit(4)));
      print_line(interp(f));
    }
    print_line(interp(e));
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind Boxed = Expr;
    bind Heap;
    demo();
  }
}
