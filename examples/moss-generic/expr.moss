import "./lib/wasi.moss" use WasiStd;
import "./lib/wasistd.moss" use Branch;
import "./lib/wasm.moss" use Wasm;
import "./lib/wasip1.moss" use Wasi;

unit Add;
unit Sub;
unit Mul;
unit Div;

type BinOp = Add | Sub | Mul | Div;

# The interface: an abstract index type, how to read a node through one,
# and how to make one.
type ExprRef;

assume Std, ExprRef {
  type Binary { op: BinOp, lhs: ExprRef, rhs: ExprRef };
  type Literal Int;

  type Expr = Binary | Literal;

  fn .data(): Expr;
  fn add(expr: Expr): ExprRef;

  context Ast = ExprRef, ExprRef.data, add;
}

# Written once, against the interface alone.
assume Std, Ast {
  fn interp(e: ExprRef): Int {
    match e.data() {
      Binary { op, lhs, rhs } => {
        let l = interp(lhs);
        let r = interp(rhs);
        match op {
          Add => l.add(r),
          Sub => l.sub(r),
          Mul => l.mul(r),
          Div => if r.eq(zero) { zero } else { l.div(r) },
        }
      },
      Literal num => num,
    }
  }

  fn lit(n: Int): ExprRef { add(Literal (n)) }
  fn bin(op: BinOp, lhs: ExprRef, rhs: ExprRef): ExprRef { add(Binary { op, lhs, rhs }) }

  fn report(e: ExprRef) {
    print_int(interp(e));
    putchar(char::newline);
  }
}

assume Std {
  fn op_code(op: BinOp): Int {
    match op {
      Add => one,
      Sub => one.add(one),
      Mul => one.add(one).add(one),
      Div => one.shl(one.add(one)),
    }
  }

  fn op_of(code: Int): BinOp {
    if code.eq(one) {
      Add
    } else if code.eq(one.add(one)) {
      Sub
    } else if code.eq(one.add(one).add(one)) {
      Mul
    } else {
      Div
    }
  }

  fn print_int(n: Int) {
    if n.lt(zero) {
      putchar(char::hyphen);
      print_int(zero.sub(n));
      return ();
    }
    let ten = one.shl(one.add(one).add(one)).add(one.add(one));
    if n.ge(ten) { print_int(n.div(ten)); }
    putchar(n.rem(ten).add(char::digit0.code()).char());
  }

  # Representation 1: a node is an index into parallel lists.
  type Idx Int;
  type Columns { ops: IntList, lhs: IntList, rhs: IntList };
  val columns: Columns;

  assume columns {
    fn Idx.at(): Int { match this { Idx i => i } }

    fn Idx.node(): Expr[ExprRef=Idx] {
      let i = this.at();
      let code = columns.ops.get(i);
      if code.eq(zero) {
        Literal (columns.lhs.get(i))
      } else {
        Binary[ExprRef=Idx] {
          op = op_of(code),
          lhs = Idx (columns.lhs.get(i)),
          rhs = Idx (columns.rhs.get(i)),
        }
      }
    }

    fn columns_add(expr: Expr[ExprRef=Idx]): Idx {
      let i = columns.ops.length();
      match expr {
        Binary { op, lhs, rhs } => {
          columns.ops.push(op_code(op));
          columns.lhs.push(lhs.at());
          columns.rhs.push(rhs.at());
        },
        Literal num => {
          columns.ops.push(zero);
          columns.lhs.push(num);
          columns.rhs.push(zero);
        },
      }
      Idx (i)
    }
  }

  # Representation 2: a node is an index into one list of triples.
  type Slot Int;
  val triples: IntList;

  assume triples {
    fn Slot.at(): Int { match this { Slot i => i } }

    fn Slot.node(): Expr[ExprRef=Slot] {
      let three = one.add(one).add(one);
      let i = this.at().mul(three);
      let code = triples.get(i);
      if code.eq(zero) {
        Literal (triples.get(i.add(one)))
      } else {
        Binary[ExprRef=Slot] {
          op = op_of(code),
          lhs = Slot (triples.get(i.add(one))),
          rhs = Slot (triples.get(i.add(one).add(one))),
        }
      }
    }

    fn triples_add(expr: Expr[ExprRef=Slot]): Slot {
      let three = one.add(one).add(one);
      let i = triples.length().div(three);
      match expr {
        Binary { op, lhs, rhs } => {
          triples.push(op_code(op));
          triples.push(lhs.at());
          triples.push(rhs.at());
        },
        Literal num => {
          triples.push(zero);
          triples.push(num);
          triples.push(zero);
        },
      }
      Slot (i)
    }
  }

  fn elsewhere() {
    bind triples = int_list();
    bind ExprRef = Slot;
    bind ExprRef.data = Slot.node;
    bind add = triples_add;
    let four = one.shl(one.add(one));
    report(bin(Div, bin(Add, lit(four), lit(four)), bin(Sub, lit(four), lit(four))));
  }

  fn demo() {
    bind columns = Columns { ops = int_list(), lhs = int_list(), rhs = int_list() };
    bind ExprRef = Idx;
    bind ExprRef.data = Idx.node;
    bind add = columns_add;
    let two = one.add(one);
    let seven = two.shl(two).sub(one);
    let ten = seven.add(two).add(one);
    let e = bin(Div, bin(Mul, bin(Sub, lit(seven), lit(ten)), lit(seven)), lit(two));
    report(e);
    elsewhere();
    report(e);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
