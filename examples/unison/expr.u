-- The pool is an ability; `withPool` handles it for one computation.
type BinOp = Add | Sub | Mul | Div

type Expr = Binary BinOp Nat Nat | Literal Int

ability ExprPool where
  add : Expr ->{ExprPool} Nat
  get : Nat ->{ExprPool} Expr

-- `Int./` floors; the post's division truncates toward zero.
quot : Int -> Int -> Int
quot x y =
  q = x Int./ y
  if Int.eq (q Int.* y) x then q
  else if Int.lt (x Int.* y) +0 then q Int.+ +1
  else q

interp : Nat ->{ExprPool} Int
interp e = match get e with
  Expr.Binary op lhs rhs ->
    l = interp lhs
    r = interp rhs
    match op with
      BinOp.Add -> l Int.+ r
      BinOp.Sub -> l Int.- r
      BinOp.Mul -> l Int.* r
      BinOp.Div -> if Int.eq r +0 then +0 else quot l r
  Expr.Literal num -> num

withPool : '{g, ExprPool} a ->{g} a
withPool p =
  go nodes = cases
    { a } -> a
    { add e -> k } -> handle k (List.size nodes) with go (List.snoc nodes e)
    { get i -> k } -> match List.at i nodes with
      Some e -> handle k e with go nodes
      None -> bug i
  handle !p with go []

lit n = add (Expr.Literal n)
bin op l r = add (Expr.Binary op l r)

say : Int ->{IO} ()
say n = match putBytes.impl (stdHandle StdOut) (Text.toUtf8 (Int.toText n Text.++ "\n")) with
  _ -> ()

main : '{IO} ()
main = do withPool do
  e = bin BinOp.Div (bin BinOp.Mul (bin BinOp.Sub (lit +7) (lit +10)) (lit +7)) (lit +2)
  say (interp e)
  withPool do say (interp (bin BinOp.Div (bin BinOp.Add (lit +4) (lit +4)) (bin BinOp.Sub (lit +4) (lit +4))))
  say (interp e)
