(* The pool is an effect; `with pool handle` gives a computation its own. *)
type binop = Add | Sub | Mul | Div
type expr = Binary of binop * int * int | Literal of int

effect PoolAdd : expr -> int
effect PoolGet : int -> expr

let add e = perform (PoolAdd e)
let get r = perform (PoolGet r)

let rec interp e =
  match get e with
  | Binary (op, lhs, rhs) ->
    let l = interp lhs in
    let r = interp rhs in
    (match op with
     | Add -> l + r
     | Sub -> l - r
     | Mul -> l * r
     | Div -> if r = 0 then 0 else l / r)
  | Literal num -> num

let rec nth (x :: xs) i = if i = 0 then x else nth xs (i - 1)

let pool = handler
  | effect (PoolAdd e) k -> (fun nodes -> continue k (length nodes) (nodes @ [e]))
  | effect (PoolGet i) k -> (fun nodes -> continue k (nth nodes i) nodes)
  | y -> (fun _ -> y)
  | finally f -> f []

let lit n = add (Literal n)
let bin op l r = add (Binary (op, l, r))
let show n = print_string (string_of_int n ^ "\n")

;;

with pool handle
  let e = bin Div (bin Mul (bin Sub (lit 7) (lit 10)) (lit 7)) (lit 2) in
  show (interp e);
  (with pool handle show (interp (bin Div (bin Add (lit 4) (lit 4)) (bin Sub (lit 4) (lit 4)))));
  show (interp e)
