    captures:
      1: storage.type.function.moss
      2: punctuation.accessor.moss
      3: entity.name.function.moss
  - match: \b(fn)\s+((?!_\b)[A-Za-z_][A-Za-z0-9_]*)(\.)((?!_\b)[A-Za-z_][A-Za-z0-9_]*)
    captures:
      1: storage.type.function.moss
      2: entity.name.type.moss
      3: punctuation.accessor.moss
      4: entity.name.function.moss
  - match: \b(fn)\s+((?!_\b)[A-Za-z_][A-Za-z0-9_]*)
    captures:
      1: storage.type.function.moss
      2: entity.name.function.moss
