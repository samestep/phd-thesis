  - match: \b_\b
    scope: constant.language.wildcard.moss
  - match: \b(?!_\b)[A-Za-z_][A-Za-z0-9_]*(?=::)
    scope: entity.name.namespace.moss
  - match: \b(?!_\b)[A-Za-z_][A-Za-z0-9_]*(?=\s*\()
    scope: entity.name.function.moss
  - match: \b[A-Z][A-Za-z0-9_]*\b
    scope: entity.name.type.moss
  - match: \b(?!_\b)[A-Za-z_][A-Za-z0-9_]*\b
