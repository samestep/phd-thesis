  - match: \b(if|else|match)\b
    scope: keyword.control.conditional.moss
  - match: \b(while|loop|for|in)\b
    scope: keyword.control.repeat.moss
  - match: \b(return|break)\b
    scope: keyword.control.flow.moss
  - match: \b(import|as|use)\b
    scope: keyword.control.import.moss
  - match: \b(assume|bind|context|fn|functor|let|tag|type|val|var)\b
